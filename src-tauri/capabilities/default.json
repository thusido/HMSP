{
  "$schema": "https://schema.tauri.app/config/2/capability.json",
  "identifier": "default",
  "description": "Default capabilities for HMSP",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:read-all",
    "fs:write-all",
    "android-fs:allow-show-open-dir-picker",
    "android-fs:allow-read-dir",
    "android-fs:allow-read-file",
    "android-fs:allow-read-text-file",
    "android-fs:allow-get-name"
  ]
}
